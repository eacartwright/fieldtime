# Copy to ".env" (git-ignored) and fill in. Used by `npm run cw`.

# ConnectWise cloud host: api-na.myconnectwise.net (US), api-eu (EU), api-aus (AUS), or your own domain
CW_SITE=api-na.myconnectwise.net

# Company ID you log in with
CW_COMPANY_ID=

# Public/private keypair from the API Member's API Keys tab
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=

# GUID registered at developer.connectwise.com
CW_CLIENT_ID=
